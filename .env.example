PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/bookmyevent

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 Configuration (Optional for local, required for uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=book-my-event

# Razorpay Configuration
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_KEY_ID_TEST=
RAZORPAY_KEY_SECRET_TEST=
RAZORPAY_KEY_ID_LIVE=
RAZORPAY_KEY_SECRET_LIVE=
RAZORPAY_WEBHOOK_SECRET_TEST=
RAZORPAY_WEBHOOK_SECRET_LIVE=

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis Cache (Optional)
REDIS_URL=

# Brevo SMTP Configuration
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=BookMyEvent
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# OTP Configurations
OTP_EXPIRY_MINUTES=10
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_DEV_FALLBACK_ENABLED=true

# Admin Seed Configurations (Optional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_MOBILE=

# UltraMsg (WhatsApp notifications)
ULTRAMSG_ENABLED=false
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=
ULTRAMSG_BASE_URL=https://api.ultramsg.com
ULTRAMSG_TIMEOUT_MS=8000
WHATSAPP_VENDOR_LEAD_NOTIFICATION_ENABLED=false

# App Base URL
APP_BASE_URL=http://localhost:5000
