# Recommended Nginx Configuration Template for BookMyEvent Production (Ubuntu VPS)

# Upstream cluster configuration for Express backend
upstream bookmyevent_backend {
    server 127.0.0.1:5000;
    
    # Keepalive connections configured to prevent connection starvation
    keepalive 32;
}

# Frontend Next.js upstream
upstream bookmyevent_frontend {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name bookmyevent.ae www.bookmyevent.ae;
    
    # Redirect all HTTP traffic to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bookmyevent.ae www.bookmyevent.ae;

    # SSL Certificates Configuration (Certbot / Let's Encrypt)
    # ssl_certificate /etc/letsencrypt/live/bookmyevent.ae/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/bookmyevent.ae/privkey.pem;
    
    # SSL Best Practices
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Next.js Frontend reverse proxy
    location / {
        proxy_pass http://bookmyevent_frontend;
        proxy_http_version 1.1;
        
        # Keepalive headers
        proxy_set_header Connection "";
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Buffer and timeout settings for Frontend
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Express Backend API reverse proxy
    location /api/ {
        proxy_pass http://bookmyevent_backend;
        proxy_http_version 1.1;
        
        # Keepalive headers to Express
        proxy_set_header Connection "";
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Robust Timeouts to prevent pages from loading indefinitely on backend delays
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffer Configuration
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        
        client_max_body_size 10M;
    }

    # Static assets direct serving if needed (or let Next.js handle it)
    location /_next/static/ {
        proxy_pass http://bookmyevent_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        expires 365d;
        access_log off;
    }
}
